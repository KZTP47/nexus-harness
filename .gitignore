# Runtime data the harness writes. The suites and config in .harness are shared;
# .harness/.gitignore names the parts that are not.
.harness/config.local.json
.harness/project-authority.json
.harness/memory/
.harness/runs/
.harness/backups/
.harness/checkpoints/
.harness/cache/
.harness/runtime/
.harness/swarm-mutation-sagas/
.harness/qa/runs/
.harness/qa/tmp/
.harness/qa/pipeline-preservation.lock
.harness/qa/pipelines-before-checks/
.harness/bundles/
.harness/qa/history.json
# What you said to an assistant, and what it said back. Yours, and about this
# machine, so it never goes into a repository.
.harness/chats/
.harness/pages/
# Machine-local memory and agent policy. These can contain private project
# paths and must never be staged with the product source.
.harness/vault/
AGENTS.md
# The report from a run of the checks. Written every time anybody runs them,
# and about that machine at that moment, so it is nobody else's business.
.harness/qa/full-report.json
.harness/qa/ci-report.json
.harness/qa/candidates.json
.harness/qa/*report*.json
.harness/transaction.lock

# The private project memory lives outside this repository. These names are a
# second boundary in case anybody accidentally copies the vault under the root.
Persistent memory for Nexus harness project/
Nexus Harness Memory/
**/.nexus-project-memory.json

# Dependencies and build output
node_modules/
desktop/build-output/
desktop/runtime/
desktop/.runtime-build.lock
desktop/.runtime-selection.json
desktop/.runtime-published/
desktop/.runtime-stage-*/
desktop/.runtime-previous-*/
.harness/desktop-deployment.lock
.harness/desktop-deployment.owner.json
desktop/build-info.json
desktop/dist/
.wheel-stage*/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# Local scratch
%SystemDrive%/
.codex-remote-attachments/
.harness/pipelines/auto2-copy.json
.harness/pipelines/first-pipeline.json
.harness/pipelines/new-automation2.json
.harness/pipelines/last-run.json
.harness/pipelines/evidence/
.harness/pipelines/drafts/
benchmark-logs/
benchmark-archive/
reports/

# A killed counterexample check can leave its isolated project copy behind.
# It is recovery/scratch data and can contain source from the current checkout.
.counterexample-sandbox-*/

# When this machine last looked at its timers, and the lock a run holds while
# it goes. About this machine at this moment, not about the project - the
# timers themselves are meant to be shared, and they are kept beside these.
.harness/timers/what-happened.json
.harness/timers/.what-happened.json
.harness/timers/.what-happened.json.could-not-be-read
.harness/timers/running.lock

# A launcher somebody made for themselves. It holds the paths on their own
# machine, so it is theirs and not the project's - and one of these got as far as
# being committed, from a check that wrote it here rather than onto a desktop.
Nexus Harness.lnk
Nexus Harness.command
Nexus Harness.desktop
