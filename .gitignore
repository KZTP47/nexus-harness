# Runtime data the harness writes. The suites and config in .harness are shared;
# .harness/.gitignore names the parts that are not.
.harness/config.local.json
.harness/memory/
.harness/runs/
.harness/backups/
.harness/checkpoints/
.harness/cache/
.harness/qa/runs/
.harness/qa/tmp/
.harness/bundles/
.harness/qa/history.json
# What you said to an assistant, and what it said back. Yours, and about this
# machine, so it never goes into a repository.
.harness/chats/
# The report from a run of the checks. Written every time anybody runs them,
# and about that machine at that moment, so it is nobody else's business.
.harness/qa/full-report.json
.harness/qa/ci-report.json
.harness/qa/candidates.json
.harness/transaction.lock

# Dependencies and build output
node_modules/
desktop/build-output/
desktop/dist/
.wheel-stage*/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# Local scratch
%SystemDrive%/
benchmark-logs/
benchmark-archive/
reports/

# When this machine last looked at its timers, and the lock a run holds while
# it goes. About this machine at this moment, not about the project - the
# timers themselves are meant to be shared, and they are kept beside these.
.harness/timers/what-happened.json
.harness/timers/.what-happened.json
.harness/timers/.what-happened.json.could-not-be-read
.harness/timers/running.lock

# A launcher somebody made for themselves. It holds the paths on their own
# machine, so it is theirs and not the project's - and one of these got as far as
# being committed, from a check that wrote it here rather than onto a desktop.
Nexus Harness.lnk
Nexus Harness.command
Nexus Harness.desktop
