{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/our-harness/harness.schema.json",
  "title": "Nexus Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "ollama",
            "local",
            "openai-compatible"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "api_mode": {
          "enum": [
            "auto",
            "responses",
            "chat-completions"
          ]
        },
        "prompt_cache_key": {
          "type": "string",
          "maxLength": 64
        },
        "prompt_cache_retention": {
          "enum": [
            "",
            "in_memory",
            "24h"
          ]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "role_output_caps": {
          "$ref": "#/$defs/roleOutputCaps"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/providerProfile"
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agentSpec"
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_unpriced_remote_calls": {
          "type": "boolean"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/priceSnapshot"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standards_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "test_commands": {
          "$ref": "#/$defs/commands"
        },
        "test_evidence_contracts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "format", "total_field", "failed_field"],
            "properties": {
              "command": {"$ref": "#/$defs/command"},
              "format": {"const": "json-stdout"},
              "total_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,7}$"},
              "failed_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,7}$"},
              "requirement_probes": {
                "type": "object",
                "maxProperties": 64,
                "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"},
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,7}$"
                }
              }
            }
          }
        },
        "lint_commands": {
          "$ref": "#/$defs/commands"
        },
        "build_commands": {
          "$ref": "#/$defs/commands"
        },
        "security_commands": {
          "$ref": "#/$defs/commands"
        },
        "performance_commands": {
          "$ref": "#/$defs/commands"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "process",
            "docker"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_changed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "inherit_environment": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "deny_executables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deny_argument_sequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "docker_image": {
          "type": "string",
          "minLength": 1
        },
        "docker_network": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allow_commit": {
          "type": "boolean"
        },
        "allow_push": {
          "type": "boolean"
        },
        "allow_merge": {
          "const": false
        },
        "protected_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_branch_prefix": {
          "type": "string"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "$ref": "#/$defs/relativePath"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "embedding_provider": {
          "type": "string"
        },
        "embedding_model": {
          "type": "string"
        },
        "allow_remote_embeddings": {
          "type": "boolean"
        }
      }
    },
    "persistent_memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "vault_path": {
          "type": "string"
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        },
        "enforce_desktop_deployment": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 10000000
        },
        "reserve_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "recent_event_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "memory_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "workspace_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "repeat_failure_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2000000
        },
        "max_tool_total_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 20000000
        },
        "reviewers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "review_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reviewer_lenses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]*$"
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "temperature_decay": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "rollback_on_exhaustion": {
          "type": "boolean"
        },
        "require_review": {
          "type": "boolean"
        },
        "require_executable_counterexamples": {
          "type": "boolean"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "transport"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "transport": {
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "allowed_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "protocol_mode": {
                "type": "string",
                "enum": [
                  "legacy",
                  "auto",
                  "modern"
                ],
                "default": "legacy"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "transport": {
                      "const": "stdio"
                    }
                  },
                  "required": [
                    "transport"
                  ]
                },
                "then": {
                  "required": [
                    "command"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "transport": {
                      "const": "http"
                    }
                  },
                  "required": [
                    "transport"
                  ]
                },
                "then": {
                  "required": [
                    "url"
                  ]
                }
              }
            ]
          }
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "enum": [
            "127.0.0.1",
            "localhost",
            "::1"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "open_browser": {
          "type": "boolean"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite": {
          "$ref": "#/$defs/relativePath"
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "default_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "artifacts_dir": {
          "$ref": "#/$defs/relativePath"
        },
        "keep_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_evidence_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "allow_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flaky_min_runs": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "flaky_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "providerName": {
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "ollama",
        "local",
        "openai-compatible"
      ]
    },
    "providerProfileName": {
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "ollama",
        "local",
        "openai-compatible",
        "codex-cli"
      ]
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "anyOf": [
        {
          "required": [
            "kind"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/providerProfileName"
        },
        "name": {
          "$ref": "#/$defs/providerProfileName"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^(?:|[A-Za-z_][A-Za-z0-9_]*)$"
        },
        "api_mode": {
          "enum": [
            "auto",
            "responses",
            "chat-completions"
          ]
        },
        "prompt_cache_key": {
          "type": "string",
          "maxLength": 64
        },
        "prompt_cache_retention": {
          "enum": [
            "",
            "in_memory",
            "24h"
          ]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "role_output_caps": {
          "$ref": "#/$defs/roleOutputCaps"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "auth_mode": {
          "enum": [
            "chatgpt"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pricing_ref": {
          "type": "string"
        },
        "allow_project_graphs": {
          "type": "boolean"
        },
        "max_data_class": {
          "enum": [
            "public",
            "project_private",
            "restricted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "kind": {
                    "const": "codex-cli"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "properties": {
                  "name": {
                    "const": "codex-cli"
                  }
                },
                "required": [
                  "name"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "command",
              "auth_mode"
            ],
            "properties": {
              "command": {
                "minItems": 1
              },
              "auth_mode": {
                "const": "chatgpt"
              },
              "endpoint": {
                "maxLength": 0
              },
              "api_key_env": {
                "maxLength": 0
              },
              "pricing_ref": {
                "maxLength": 0
              }
            }
          },
          "else": {
            "required": [
              "endpoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "local"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "openai",
                  "anthropic",
                  "gemini"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "api_key_env"
            ],
            "properties": {
              "api_key_env": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "openai",
                  "anthropic",
                  "gemini"
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "required": [
              "api_key_env"
            ],
            "properties": {
              "api_key_env": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "agentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_ref"
      ],
      "properties": {
        "provider_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 100000
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
          },
          "uniqueItems": true
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "roleOutputCaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planner": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "coder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "evaluator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "merge": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "priceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "model_pattern",
        "input_per_million_microusd",
        "output_per_million_microusd",
        "effective_at",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/providerName"
        },
        "model_pattern": {
          "type": "string",
          "minLength": 1
        },
        "input_per_million_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cached_input_per_million_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cache_write_per_million_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output_per_million_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "effective_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{1,2})"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        }
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  }
}
