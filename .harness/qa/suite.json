{
  "schema_version": 1,
  "name": "our-harness",
  "cases": [
    {
      "id": "qa-tests",
      "title": "The test lab's own tests pass",
      "kind": "command",
      "tags": [
        "fast",
        "tests"
      ],
      "command": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        "tests",
        "-p",
        "test_qa.py",
        "-q"
      ],
      "timeout_seconds": 300,
      "expect": {
        "exit_code": 0,
        "stderr_contains": [
          "OK"
        ]
      }
    },
    {
      "id": "cli-help",
      "title": "The command line starts and lists its commands",
      "kind": "command",
      "tags": [
        "fast",
        "cli"
      ],
      "command": [
        "python",
        "-m",
        "our_harness",
        "--help"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_contains": [
          "qa",
          "run",
          "doctor"
        ]
      }
    },
    {
      "id": "readme",
      "title": "The README explains how to install",
      "kind": "file",
      "tags": [
        "fast",
        "docs"
      ],
      "path": "README.md",
      "expect": {
        "exists": true,
        "contains": [
          "Fast install"
        ],
        "min_bytes": 500
      }
    },
    {
      "id": "no-secrets-in-config",
      "title": "The shared config holds no API key values",
      "kind": "file",
      "tags": [
        "fast",
        "safety"
      ],
      "path": ".harness/config.json",
      "expect": {
        "exists": true,
        "not_contains": [
          "sk-",
          "api_key\":"
        ]
      }
    },
    {
      "id": "ui-health",
      "title": "The control panel answers when it is running",
      "kind": "http",
      "tags": [
        "ui"
      ],
      "url": "http://127.0.0.1:8765/api/health",
      "expect": {
        "status": 200,
        "json_fields": {
          "status": "ok"
        }
      }
    },
    {
      "id": "ui-pages",
      "title": "The control panel opens with no browser errors",
      "kind": "browser",
      "tags": [
        "ui"
      ],
      "url": "http://127.0.0.1:8765/",
      "routes": [
        "/"
      ],
      "check_accessibility": true,
      "expect": {
        "max_console_errors": 0,
        "max_page_errors": 0,
        "max_failed_requests": 0,
        "body_contains": [
          "Welcome"
        ],
        "max_accessibility_problems": 0
      }
    }
  ]
}
