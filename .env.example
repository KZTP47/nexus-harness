# Copy values into your shell or secret manager. Do not commit a populated .env file.

# OpenAI provider
OPENAI_API_KEY=
# Or set one direct per-process override:
# HARNESS_API_KEY=

# Anthropic provider
ANTHROPIC_API_KEY=

# Google Gemini provider
GEMINI_API_KEY=

# Common overrides
HARNESS_PROVIDER=ollama
HARNESS_MODEL=qwen2.5-coder:7b
HARNESS_ENDPOINT=http://127.0.0.1:11434

# Nested override examples
HARNESS__WORKFLOW__MAX_ITERATIONS=4
HARNESS__EXECUTION__TIMEOUT_SECONDS=180
