{
  "name": "our-harness-desktop",
  "version": "0.2.1",
  "description": "Desktop window for the Nexus Harness control panel",
  "main": "main.js",
  "private": true,
  "dependencies": {
    "playwright-core": "1.62.1"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "prebuild": "python ../scripts/prepare_build_info.py",
    "build": "python ../scripts/build_windows_desktop.py",
    "smoke": "node smoke.js",
    "smoke:packaged": "node packaged.smoke.js",
    "smoke:built": "node built.smoke.js",
    "smoke:asking": "node asking.smoke.js",
    "smoke:board": "node board.smoke.js",
    "e2e:multi-vendor": "node multi-vendor.e2e.js",
    "smoke:automations": "node automations.smoke.js",
    "smoke:web-chat": "node web-chat.smoke.js",
    "smoke:claude-browser": "node claude-browser.smoke.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.ourharness.desktop",
    "productName": "Nexus Harness",
    "files": [
      "main.js",
      "settings-store.js",
      "server.js",
      "guards.js",
      "preload.js",
      "web-chats.js",
      "external-browser.js",
      "web-chat-shell-preload.js",
      "pages/**",
      "nexus-harness.ico",
      "build-info.json",
      "package.json",
      "!**/*.test.js",
      "!smoke.js",
      "!packaged.smoke.js",
      "!built.smoke.js",
      "!asking.smoke.js",
      "!multi-vendor.e2e.js",
      "!web-chat.smoke.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "nexus-harness.ico",
      "artifactName": "Nexus-Harness-Setup-${version}-UNSIGNED-DEV.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "nexus-harness.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "nexus-harness.ico"
    },
    "directories": {
      "output": "build-output"
    },
    "extraResources": [
      {
        "from": "../src",
        "to": "harness/src"
      },
      {
        "from": "../scripts/harness.py",
        "to": "harness/scripts/harness.py"
      },
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "nsis": {
      "installerIcon": "nexus-harness.ico",
      "uninstallerIcon": "nexus-harness.ico",
      "installerHeaderIcon": "nexus-harness.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Harness",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "Nexus Harness"
}
